# ====================================================================
# HBPLUS Employee Portal - Environment Configuration
# ====================================================================
# Duplicate this file to .env or .env.local and populate with your credentials.
# In Expo, variables accessible in the client bundle must be prefixed with EXPO_PUBLIC_

# --------------------------------------------------------------------
# Firebase Client SDK Configuration (Required for Web, Android & iOS)
# Obtain these from your Firebase Console -> Project Settings -> General -> Your Apps
# --------------------------------------------------------------------
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyExampleApiKey1234567890abcdef
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=hbplus-auth.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=hbplus-auth
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=hbplus-auth.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Required for Native Android & iOS)
# Obtain Web Client ID from Google Cloud Console -> APIs & Credentials -> OAuth 2.0 Client IDs
# --------------------------------------------------------------------
# Web Client ID is used on Android to request the Google ID token for Firebase
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com

# iOS Client ID (Optional, needed for iOS native sign-in)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123456789012-iosclientidexample.apps.googleusercontent.com

# --------------------------------------------------------------------
# Corporate Domain Policy Configuration
# --------------------------------------------------------------------
EXPO_PUBLIC_AUTHORIZED_DOMAIN=hbplus.fit
